# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/lendit?retryWrites=true&w=majority"

# Random secret for signing sessions. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The site's public URL (http://localhost:3000 locally, your Vercel URL in production)
NEXTAUTH_URL="http://localhost:3000"

# Optional: days to keep the admin audit log (default 365, minimum 30)
# AUDIT_RETENTION_DAYS=365

# Optional: lets Power BI pull the CSV exports (/api/admin/export/{loans|units|issues|users|audit})
# with header  Authorization: Bearer <token>.  At least 32 chars:  openssl rand -hex 32
# POWERBI_TOKEN=
